---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/home/ContactCTA.astro';
import { introduction, practice } from '../data/home';
import { LinkButton } from '../components/ui/link-button';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="À propos — Alex Rafanomezantsoa"
  description="Alex Rafanomezantsoa, designer et développeur pluridisciplinaire à Nosy Be, Madagascar."
>
  <div class="container editorial-page editorial-grid">
    <header class="editorial-heading">
      <p class="eyebrow">À propos · {introduction.location}</p>
      <h1>Entre design<br />et développement.</h1>
      <p>{introduction.role}</p>
    </header>
    <div class="editorial-stack">
      <section class="editorial-section" aria-labelledby="about-practice">
        <h2 id="about-practice">Une pratique pluridisciplinaire</h2>
        <p>{introduction.bio}</p>
        <ul class="practice-list">
          {practice.map((item) => <li>{item}</li>)}
        </ul>
        <LinkButton href={withBase('work/')}>Découvrir les projets</LinkButton>
        <LinkButton href={withBase('cv/')}>Consulter mon CV</LinkButton>
      </section>
      <section class="editorial-section" aria-labelledby="about-experiments">
        <h2 id="about-experiments">Un espace pour explorer</h2>
        <p>
          Le laboratoire rassemble mes recherches visuelles et techniques : création d’images avec
          l’IA, outils pour tableurs, traitement du malgache et construction de ce portfolio.
        </p>
        <LinkButton href={withBase('lab/')}>Parcourir le laboratoire</LinkButton>
      </section>
      <ContactCTA />
    </div>
  </div>
</BaseLayout>
<style>
  .practice-list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding-left: var(--space-5);
    color: var(--color-text-muted);
  }
</style>
