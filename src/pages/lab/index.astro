---
import { getCollection } from 'astro:content';
import { labStatusLabels } from '../../data/labels';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';
import { Badge } from '../../components/ui/badge';
import { CollectionEmpty } from '../../components/blocks/collection-empty';
import { LinkButton } from '../../components/ui/link-button';

const entries = (await getCollection('lab', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title, 'fr'),
);
---

<BaseLayout
  title="Laboratoire — Alex Rafanomezantsoa"
  description="Expérimentations, prototypes et explorations techniques d’Alex Rafanomezantsoa."
>
  <div class="container editorial-page editorial-grid">
    <header class="editorial-heading">
      <p class="eyebrow">Recherches et essais</p>
      <h1>Laboratoire.</h1>
      <p>
        Des pistes en cours, des prototypes et des notes de conception autour de l’image, des
        données et du code.
      </p>
      <LinkButton href={withBase('work/')}>Découvrir les projets</LinkButton>
    </header>
    {
      entries.length > 0 ? (
        <ul class="experiments" aria-label="Expérimentations">
          {entries.map((entry) => (
            <li>
              <a href={withBase(`lab/${entry.id}/`)} aria-labelledby={`lab-${entry.id}`}>
                <p class="eyebrow">
                  <Badge variant="outline">{labStatusLabels[entry.data.status]}</Badge> ·{' '}
                  {entry.data.year}
                </p>
                <h2 id={`lab-${entry.id}`}>
                  {entry.data.title}
                  <span aria-hidden="true"> ↗</span>
                </h2>
                <p class="experiment-summary">{entry.data.summary}</p>
                <p class="experiment-tags">{entry.data.tags.join(' · ')}</p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <CollectionEmpty
          title="Expérimentations à venir"
          description="Les expérimentations sont en cours de préparation."
        />
      )
    }
  </div>
</BaseLayout>
<style>
  .experiments {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .experiments li + li {
    border-top: 1px solid var(--color-border);
  }
  .experiments h2 {
    margin: var(--space-3) 0;
    font-size: var(--font-size-body-lg);
    line-height: var(--line-snug);
  }
  .experiments a {
    display: block;
    padding-block: var(--space-6);
    text-decoration: none;
  }
  .experiments li:first-child a {
    padding-top: 0;
  }
  .experiments a:is(:hover, :focus-visible) h2 {
    text-decoration: underline;
  }
  .experiment-summary {
    margin: 0;
    max-width: 50ch;
    color: var(--color-text-muted);
  }
  .experiment-tags {
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-nav);
  }
</style>
