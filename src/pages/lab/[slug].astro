---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { labStatusLabels } from '../../data/labels';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';
import { LinkButton } from '../../components/ui/link-button';
import { Badge } from '../../components/ui/badge';

export async function getStaticPaths() {
  const entries = await getCollection('lab', ({ data }) => !data.draft);

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'lab'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const links = [
  entry.data.url ? { label: 'Voir le projet', href: entry.data.url } : null,
  entry.data.repositoryUrl
    ? { label: 'Voir le code source', href: entry.data.repositoryUrl }
    : null,
].filter((link): link is { label: string; href: string } => link !== null);
---

<BaseLayout
  title={`${entry.data.title} — Laboratoire — Alex Rafanomezantsoa`}
  description={entry.data.summary}
>
  <article class="lab-detail container editorial-page">
    <LinkButton direction="left" href={withBase('lab/')}>Laboratoire</LinkButton>
    <div class="editorial-grid lab-opening">
      <header class="lab-detail-header editorial-heading">
        <p class="eyebrow">Laboratoire · {entry.data.year}</p>
        <h1>{entry.data.title}</h1>
        <p class="lab-detail-summary">{entry.data.summary}</p>
        <dl class="lab-detail-meta">
          <div>
            <dt>État de l’exploration</dt><dd>
              <Badge variant="outline">{labStatusLabels[entry.data.status]}</Badge>
            </dd>
          </div>
          <div><dt>Thèmes</dt><dd>{entry.data.tags.join(' · ')}</dd></div>
        </dl>

        {
          links.length > 0 && (
            <p class="lab-detail-links">
              {links.map((link) => (
                <LinkButton
                  direction="external"
                  href={link.href}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  {link.label}
                </LinkButton>
              ))}
            </p>
          )
        }
      </header>

      <div class="lab-detail-body editorial-reading">
        <Content />
      </div>
    </div>
    <footer class="lab-detail-footer page-actions">
      <LinkButton href={withBase('lab/')} direction="left">Retour au laboratoire</LinkButton>
      <LinkButton href={withBase('contact/')}>Échanger sur cette exploration</LinkButton>
    </footer>
  </article>
</BaseLayout>

<style>
  .lab-opening {
    margin-top: var(--space-6);
  }
  .lab-detail-meta {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-5);
    margin: var(--space-5) 0 0;
    border-top: 1px solid var(--color-border);
  }
  .lab-detail-meta dt {
    color: var(--color-text-muted);
    font-size: var(--font-size-meta);
  }
  .lab-detail-meta dd {
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-nav);
  }
  .lab-detail-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .lab-detail-footer {
    justify-content: space-between;
    margin-top: var(--section-space);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
</style>
