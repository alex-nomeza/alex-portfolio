---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { introduction } from '../data/home';
import { LinkButton } from '../components/ui/link-button';
---

<BaseLayout
  title="Contact — Alex Rafanomezantsoa"
  description="Contactez Alex Rafanomezantsoa pour vos projets d’identité visuelle, de design éditorial, de sites web et de produits numériques."
>
  <div class="container editorial-page editorial-grid">
    <header class="editorial-heading">
      <p class="eyebrow">Contact</p>
      <h1>Parlons de<br />votre projet.</h1>
      <p>
        Identité visuelle, édition, site web ou interface : racontez-moi ce que vous souhaitez
        construire.
      </p>
    </header>
    <div class="editorial-stack">
      <section class="editorial-section" aria-labelledby="email-title">
        <h2 id="email-title">Écrivez-moi</h2>
        <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
        <p>
          Quelques lignes suffisent pour commencer. Vous pouvez joindre des références ou un brief
          si vous en avez déjà un.
        </p>
      </section>
      <section class="editorial-section" aria-labelledby="brief-title">
        <h2 id="brief-title">Pour préparer l’échange</h2>
        <dl class="brief-list">
          <div>
            <dt>Le contexte</dt><dd>Votre activité, le public concerné et l’objectif du projet.</dd>
          </div>
          <div><dt>Le besoin</dt><dd>Les supports à concevoir et ce qui existe déjà.</dd></div>
          <div>
            <dt>Le cadre</dt><dd>
              Le calendrier souhaité et le budget envisagé, s’ils sont définis.
            </dd>
          </div>
        </dl>
      </section>
      <section class="editorial-section" aria-labelledby="location-title">
        <h2 id="location-title">{introduction.location}</h2>
        <p>Heure de Madagascar · UTC+3</p>
        <LinkButton href={profile.githubUrl} direction="external"
          >Retrouvez-moi sur GitHub</LinkButton
        >
      </section>
    </div>
  </div>
</BaseLayout>
<style>
  .brief-list {
    display: grid;
    gap: var(--space-5);
    margin: 0;
  }
  .brief-list dt {
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-nav);
  }
  .brief-list dd {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
  }
  .email {
    width: fit-content;
    max-width: 100%;
    padding-block: var(--space-2);
    overflow-wrap: anywhere;
    font-size: var(--font-size-body-lg);
    text-decoration-thickness: 1px;
  }
</style>
