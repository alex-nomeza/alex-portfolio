---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
import { LinkButton } from '../components/ui/link-button';
---

<BaseLayout
  title="Page introuvable — Alex Rafanomezantsoa"
  description="La page demandée est introuvable."
  noindex
>
  <div class="container editorial-page editorial-grid">
    <header class="editorial-heading">
      <p class="eyebrow">Erreur 404</p><h1>Cette page<br />n’existe pas.</h1>
    </header>
    <div class="editorial-heading">
      <p>
        Le lien a peut-être changé ou la page a été retirée. Vous pouvez retrouver les projets ou
        revenir à l’accueil.
      </p>
      <div class="page-actions">
        <LinkButton href={withBase('work/')} variant="outline">Voir les projets</LinkButton>
        <LinkButton href={withBase()} direction="left">Retour à l’accueil</LinkButton>
      </div>
    </div>
  </div>
</BaseLayout>
