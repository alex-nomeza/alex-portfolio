---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedProjects } from '../../utils/projects';
import { withBase } from '../../utils/paths';
import { CollectionEmpty } from '../../components/blocks/collection-empty';
import { LinkButton } from '../../components/ui/link-button';
import SiteDemos from '../../components/project/SiteDemos.astro';
const projects = await getPublishedProjects();
---

<BaseLayout
  title="Projets — Alex Rafanomezantsoa"
  description="Une sélection de projets de design et de développement d’Alex Rafanomezantsoa."
>
  <div class="container editorial-page editorial-grid">
    <header class="editorial-heading">
      <p class="eyebrow">Portfolio</p>
      <h1>Projets.</h1>
      <p>
        Identités, publications et interfaces. Une sélection de concepts et d’études, du langage
        visuel à l’expérience numérique.
      </p>
      <LinkButton href={withBase('lab/')}>Voir aussi le laboratoire</LinkButton>
    </header>
    <div class="editorial-stack">
      {
        projects.length > 0 ? (
          <ul class="work-index" aria-label="Projets">
            {projects.map((project) => (
              <li>
                <a href={withBase(`work/${project.id}/`)} aria-labelledby={`project-${project.id}`}>
                  <div class="work-title">
                    <h2 id={`project-${project.id}`}>{project.data.title}</h2>
                    <span aria-hidden="true">↗</span>
                  </div>
                  <p class="work-summary">{project.data.summary}</p>
                  <p class="work-meta">
                    {project.data.year} · {project.data.disciplines.join(' · ')}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <CollectionEmpty
            title="Projets à venir"
            description="Les projets sont en cours de préparation."
          />
        )
      }
      <SiteDemos />
      <div class="page-actions">
        <LinkButton href={withBase('contact/')}>Parlons de votre projet</LinkButton>
      </div>
    </div>
  </div>
</BaseLayout>
<style>
  .work-index {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .work-index li + li {
    border-top: 1px solid var(--color-border);
  }
  .work-index a {
    display: block;
    padding-block: var(--space-6);
    text-decoration: none;
  }
  .work-index li:first-child a {
    padding-top: 0;
  }
  .work-index h2 {
    font-size: var(--font-size-body-lg);
    line-height: var(--line-snug);
  }
  .work-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .work-summary {
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
  }
  .work-meta {
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-nav);
  }
  .work-index a:is(:hover, :focus-visible) h2 {
    text-decoration: underline;
  }
</style>
