---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Button } from '../ui/button';
import { zahirViews } from '../../data/le-zahir';
interface Props {
  src: ImageMetadata;
  alt: string;
}
const { src, alt } = Astro.props;
---

<section
  class="showcase"
  data-zahir-slideshow
  aria-label="Le Zahir en images"
  aria-roledescription="diaporama"
>
  <div class="showcase-heading">
    <p class="eyebrow">Exploration visuelle</p>
    <p class="view-count" aria-hidden="true"><span data-current>01</span> / 03</p>
  </div>
  <div
    class="scene"
    tabindex="0"
    aria-label="Images du projet. Utilisez les flèches gauche et droite."
  >
    <div class="projection">
      {
        zahirViews.map((view, index) => (
          <figure
            class="slide"
            data-slide
            data-active={index === 0 ? 'true' : undefined}
            aria-label={`${index + 1} sur ${zahirViews.length} : ${view.title}`}
            aria-roledescription="diapositive"
            style={`--image-scale:${view.scale};--image-origin:${view.origin};`}
          >
            <div class="artwork">
              <Image
                src={src}
                alt={index === 0 ? alt : view.caption}
                widths={[768, 1200, 1600, 2000]}
                sizes="(min-width: 82rem) 1100px, 90vw"
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            </div>
            <figcaption>
              <>
                <span>{view.title}</span>
                <span>{view.caption}</span>
              </>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
  <div class="showcase-controls" hidden>
    <div class="view-selectors" aria-label="Choisir une vue">
      {
        zahirViews.map((view, index) => (
          <Button
            variant="ghost"
            data-view={index}
            aria-pressed={index === 0}
            aria-label={`Afficher ${view.title}`}
          >
            <span class="view-index" aria-hidden="true">
              0{index + 1}
            </span>
            {view.title}
          </Button>
        ))
      }
    </div>
    <div class="arrows">
      <Button variant="outline" size="icon" data-previous aria-label="Image précédente">←</Button>
      <Button variant="outline" size="icon" data-next aria-label="Image suivante">→</Button>
    </div>
  </div>
  <p class="sr-only" data-status aria-live="polite" aria-atomic="true"></p>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-zahir-slideshow]');
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const selectors = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-view]'));
    const scene = root.querySelector<HTMLElement>('.scene')!;
    const count = root.querySelector<HTMLElement>('[data-current]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    let current = 0;
    const show = (next: number) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        slide.toggleAttribute('data-active', index === current);
        slide.setAttribute('aria-hidden', String(index !== current));
      });
      selectors.forEach((button, index) =>
        button.setAttribute('aria-pressed', String(index === current)),
      );
      count.textContent = String(current + 1).padStart(2, '0');
      status.textContent = slides[current].getAttribute('aria-label');
    };
    root.querySelector('[data-previous]')?.addEventListener('click', () => show(current - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
    selectors.forEach((button, index) => button.addEventListener('click', () => show(index)));
    scene.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      show(
        event.key === 'Home'
          ? 0
          : event.key === 'End'
            ? slides.length - 1
            : current + (event.key === 'ArrowRight' ? 1 : -1),
      );
    });
    let start: { x: number; y: number } | null = null;
    scene.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'touch') start = { x: event.clientX, y: event.clientY };
    });
    scene.addEventListener('pointerup', (event) => {
      if (!start) return;
      const dx = event.clientX - start.x;
      const dy = event.clientY - start.y;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1));
      start = null;
    });
    scene.addEventListener('pointercancel', () => {
      start = null;
    });
    root.dataset.enhanced = 'true';
    show(0);
    root.querySelector<HTMLElement>('.showcase-controls')!.hidden = false;
  }
</script>

<style>
  .showcase {
    --projection-inset: clamp(1.5rem, 5vw, 4rem);
    margin-top: var(--space-7);
  }
  .showcase-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .view-count {
    margin: 0;
    font-size: var(--font-size-meta);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }
  .view-count span {
    color: var(--color-text);
  }
  .scene {
    overflow: hidden;
    padding: var(--projection-inset);
    background: #eae9e3;
    perspective: 1400px;
    touch-action: pan-y pinch-zoom;
  }
  .projection {
    position: relative;
    isolation: isolate;
  }
  .projection::before,
  .projection::after {
    content: '';
    position: absolute;
    inset: 0 0 var(--space-8);
    border: 1px solid #8d938d;
    pointer-events: none;
    z-index: -1;
  }
  .projection::before {
    transform: translate(12px, -10px) rotate(1deg);
    opacity: 0.5;
  }
  .projection::after {
    transform: translate(-12px, 10px) rotate(-1deg);
    opacity: 0.35;
  }
  .slide {
    margin: 0;
  }
  .slide + .slide {
    margin-top: var(--space-7);
  }
  .artwork {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-text);
    box-shadow: 0 18px 36px -24px #1118;
  }
  .artwork::after {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    background: linear-gradient(115deg, transparent 25%, #e0f5e91c 45%, #fff2 50%, transparent 68%);
    mix-blend-mode: screen;
  }
  .artwork img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(var(--image-scale));
    transform-origin: var(--image-origin);
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
  }
  figcaption span:first-child {
    font-size: var(--font-size-nav);
    font-weight: var(--font-weight-medium);
  }
  figcaption span:last-child {
    font-size: var(--font-size-meta);
    color: var(--color-text-muted);
  }
  [data-enhanced] .projection {
    display: grid;
  }
  [data-enhanced] .slide {
    grid-area: 1 / 1;
    min-width: 0;
    margin: 0;
    visibility: hidden;
    opacity: 0;
    transform: translateX(3%) rotateY(-5deg) scale(0.96);
    transition:
      opacity var(--duration-slow) var(--ease-out),
      transform var(--duration-slow) var(--ease-out),
      visibility var(--duration-slow);
  }
  [data-enhanced] .slide[data-active] {
    visibility: visible;
    opacity: 1;
    transform: none;
    z-index: 1;
  }
  [data-enhanced] .slide[data-active] .artwork::after {
    animation: projection-light 900ms var(--ease-out) both;
  }
  @keyframes projection-light {
    from {
      transform: translateX(-60%);
      opacity: 0;
    }
    40% {
      opacity: 1;
    }
    to {
      transform: translateX(25%);
      opacity: 0.35;
    }
  }
  .showcase-controls:not([hidden]) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }
  .view-selectors,
  .arrows {
    display: flex;
    gap: var(--space-2);
  }
  .view-selectors {
    flex-wrap: wrap;
  }
  .view-selectors :global(button[aria-pressed='true']) {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .view-index {
    font-size: var(--font-size-meta);
    opacity: 0.65;
  }
  @media (min-width: 56rem) {
    .artwork {
      aspect-ratio: 16 / 9;
    }
  }
  @media (max-width: 40rem) {
    figcaption {
      flex-direction: column;
      gap: var(--space-1);
      min-height: 5rem;
    }
    .showcase-controls:not([hidden]) {
      flex-wrap: wrap;
    }
    .view-selectors {
      flex: 1 1 100%;
    }
    .view-selectors :global(button) {
      flex: 1;
      padding-inline: var(--space-2);
      font-size: var(--font-size-meta);
    }
    .arrows {
      margin-left: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-enhanced] .slide {
      transition: none;
      transform: none;
    }
  }
  .showcase:not([data-enhanced]) .slide {
    visibility: visible;
  }
</style>
