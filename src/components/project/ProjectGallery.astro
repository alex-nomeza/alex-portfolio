---
import type { ImageMetadata } from 'astro';
import Figure from './Figure.astro';

interface MediaItem {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  layout?: 'full' | 'wide' | 'half' | 'portrait';
}

interface Props {
  items: MediaItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="project-media">
      {items.map((item) => (
        <Figure
          src={item.src}
          alt={item.alt}
          caption={item.caption}
          layout={item.layout ?? 'wide'}
        />
      ))}
    </div>
  )
}

<style>
  /* Editorial media rhythm: a strong single column that breaks into paired
     halves where the content asks for it. Not a uniform card grid. */
  .project-media {
    display: grid;
    gap: var(--space-7) var(--page-gutter);
    margin-top: var(--section-space);
  }

  @media (min-width: 48rem) {
    .project-media {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }

    .project-media :global(.figure) {
      grid-column: 1 / -1;
    }

    .project-media :global(.figure[data-layout='half']) {
      grid-column: span 1;
    }

    .project-media :global(.figure[data-layout='portrait']) {
      grid-column: span 1;
      max-width: 32rem;
    }
  }
</style>
