---
import { withBase } from '../../utils/paths';
import type { Project } from '../../utils/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<nav class="next-project" aria-label="Projet suivant">
  <a href={withBase(`work/${project.id}/`)}>
    <span class="next-label">Projet suivant</span>
    <span class="next-title">{project.data.title}</span>
    <span class="next-meta">
      {project.data.disciplines.join(', ')} · {project.data.year}
    </span>
  </a>
</nav>

<style>
  .next-project {
    margin-top: var(--section-space);
    border-top: 1px solid var(--color-border);
  }

  .next-project a {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-6);
    text-decoration: none;
  }

  @media (min-width: 56rem) {
    .next-project a {
      grid-template-columns: var(--editorial-left) var(--editorial-right);
      column-gap: var(--editorial-gap);
      align-items: baseline;
    }
    .next-meta {
      grid-column: 2;
    }
  }
  .next-label {
    color: var(--color-text-muted);
    font-family: var(--font-meta);
    font-size: var(--font-size-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .next-title {
    font-family: var(--font-display);
    font-size: var(--font-size-body-lg);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-tight);
    line-height: var(--line-snug);
  }

  .next-project a:is(:hover, :focus-visible) .next-title {
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .next-title::after {
    content: ' \2192'; /* → */
  }

  .next-meta {
    color: var(--color-text-muted);
    font-family: var(--font-meta);
    font-size: var(--font-size-meta);
  }
</style>
