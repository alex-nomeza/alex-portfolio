---
import { profile } from '../../data/profile';
import { LinkButton } from '../ui/link-button';
---

<section id="contact" class="contact-cta" aria-labelledby="contact-heading">
  <h2 id="contact-heading">Un projet, une collaboration ?</h2>
  <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
  <LinkButton href={profile.githubUrl} direction="external">GitHub</LinkButton>
</section>
<style>
  .contact-cta {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  h2 {
    font-size: var(--font-size-nav);
    line-height: var(--line-body);
    letter-spacing: 0;
    font-weight: var(--font-weight-semibold);
  }
  .email {
    width: fit-content;
    max-width: 100%;
    overflow-wrap: anywhere;
    font-size: var(--font-size-body-lg);
    line-height: var(--line-body);
    text-decoration-thickness: 1px;
  }
</style>
