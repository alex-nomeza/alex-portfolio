---
import { getPublishedProjects, getFeaturedProjects } from '../../utils/projects';
import { withBase } from '../../utils/paths';
import { CollectionEmpty } from '../blocks/collection-empty';

const featured = await getFeaturedProjects();
const selected = (featured.length > 0 ? featured : await getPublishedProjects()).slice(0, 5);
---

<section id="selected-work" class="selected-projects" aria-labelledby="selected-work-title">
  <h2 id="selected-work-title">Quelques projets</h2>
  {
    selected.length === 0 ? (
      <CollectionEmpty
        title="Projets à venir"
        description="Les projets sélectionnés sont en cours de préparation."
      />
    ) : (
      <ul class="project-list">
        {selected.map((project) => (
          <li>
            <a href={withBase(`work/${project.id}/`)}>{project.data.title}</a>
            <p>{project.data.summary}</p>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  #selected-work {
    min-width: 0;
  }
  h2 {
    font-size: var(--font-size-body-lg);
    line-height: var(--line-snug);
  }

  .project-list {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .project-list a {
    font-family: var(--font-display);
    display: flex;
    align-items: center;
    min-height: var(--control-height);
    padding: var(--space-2) 0;
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-heading);
    line-height: var(--line-snug);
    text-decoration: none;
    width: fit-content;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .project-list p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-nav);
  }

  .project-list a:hover,
  .project-list a:focus-visible {
    text-decoration: underline;
    color: var(--color-text-muted);
  }
</style>
