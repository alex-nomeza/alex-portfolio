---
import { getCollection } from 'astro:content';
import { withBase } from '../../utils/paths';

const entries = (await getCollection('lab', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title),
);

const featured = entries.filter((e) => e.data.featured);
const selected = (featured.length > 0 ? featured : entries).slice(0, 3);
---

<section class="section container" aria-labelledby="lab-teaser-title">
  <div class="section-head">
    <h2 id="lab-teaser-title">Lab</h2>
    <a class="link-arrow" data-dir="right" href={withBase('lab/')}>Enter the Lab</a>
  </div>

  {
    selected.length === 0 ? (
      <p class="section-empty">
        Experiments, prototypes and open-source explorations will surface here.
      </p>
    ) : (
      <ul class="lab-teaser">
        {selected.map((entry) => (
          <li>
            <p class="lab-year">{entry.data.year}</p>
            <h3 class="lab-title">{entry.data.title}</h3>
            <p class="lab-summary">{entry.data.summary}</p>
            <ul class="lab-tags">
              {entry.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .section-empty {
    margin: var(--space-7) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-body-lg);
  }

  .lab-teaser {
    display: grid;
    gap: var(--space-7) var(--page-gutter);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .lab-teaser {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .lab-teaser > li {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .lab-year {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-meta);
    font-size: var(--font-size-meta);
  }

  .lab-title {
    margin: 0;
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-heading);
    line-height: var(--line-snug);
  }

  .lab-summary {
    max-width: 40ch;
    margin: 0;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .lab-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-meta);
    font-size: var(--font-size-meta);
    color: var(--color-text-muted);
  }
</style>
