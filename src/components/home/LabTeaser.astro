---
import { getCollection } from 'astro:content';
import { withBase } from '../../utils/paths';
import { LinkButton } from '../ui/link-button';
import { Badge } from '../ui/badge';
import { labStatusLabels } from '../../data/labels';
import { CollectionEmpty } from '../blocks/collection-empty';

const entries = (await getCollection('lab', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title, 'fr'),
);

const featured = entries.filter((e) => e.data.featured);
const selected = (featured.length > 0 ? featured : entries).slice(0, 4);
---

<section aria-labelledby="lab-teaser-title">
  <h2 id="lab-teaser-title">Ce que j’explore</h2>

  {
    selected.length === 0 ? (
      <CollectionEmpty
        title="Laboratoire à venir"
        description="Les expérimentations, prototypes et explorations libres seront présentés ici."
      />
    ) : (
      <ul class="lab-teaser">
        {selected.map((entry) => (
          <li>
            <div class="lab-heading">
              <h3 class="lab-title">
                <a href={withBase(`lab/${entry.id}/`)}>{entry.data.title}</a>
              </h3>
              <Badge variant="outline">{labStatusLabels[entry.data.status]}</Badge>
            </div>
            <p class="lab-summary">{entry.data.summary}</p>
          </li>
        ))}
      </ul>
    )
  }
  <LinkButton href={withBase('lab/')}>Tout le laboratoire</LinkButton>
</section>

<style>
  .lab-teaser {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-5) 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  h2 {
    font-size: var(--font-size-body-lg);
    line-height: var(--line-snug);
  }

  .lab-teaser > li {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }
  .lab-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .lab-title {
    margin: 0;
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-heading);
    line-height: var(--line-snug);
  }
  .lab-title a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-height);
    text-decoration: none;
  }
  .lab-title a:is(:hover, :focus-visible) {
    text-decoration: underline;
  }

  .lab-summary {
    margin: 0;
    color: var(--color-text-muted);
    text-wrap: pretty;
    font-size: var(--font-size-nav);
  }
</style>
