---
import { introduction } from '../../data/home';
import { profile } from '../../data/profile';
import { LinkButton } from '../ui/link-button';
---

<section id="about" class="hero" aria-labelledby="home-title">
  <p class="eyebrow">{introduction.location}</p>
  <h1 id="home-title">{introduction.name}</h1>
  <p class="hero-role">{introduction.role}</p>
  <p class="hero-lede">{introduction.bio}</p>
  <div class="profile-links">
    <LinkButton href={profile.githubUrl} direction="external">GitHub</LinkButton>
    <LinkButton href={`mailto:${profile.email}`}>Me contacter</LinkButton>
  </div>
</section>
<style>
  .hero {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }
  .hero h1 {
    font-size: var(--font-size-hero);
    line-height: var(--line-snug);
    max-width: none;
    text-wrap: initial;
  }
  .hero-lede {
    max-width: var(--text-max);
    margin: 0;
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
  }
  .hero-role {
    margin: 0;
    font-size: var(--font-size-body-lg);
  }
  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
</style>
