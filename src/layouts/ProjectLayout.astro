---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  year: number;
  disciplines: string[];
  role: string[];
}

const { title, description, year, disciplines, role } = Astro.props;
---

<BaseLayout title={`${title} — Alex Mezan`} description={description}>
  <article class="page-shell project-shell">
    <header class="project-header">
      <p class="eyebrow">Project · {year}</p>
      <h1>{title}</h1>
      <dl>
        <div>
          <dt>Disciplines</dt>
          <dd>{disciplines.join(', ')}</dd>
        </div>
        <div>
          <dt>Role</dt>
          <dd>{role.join(', ')}</dd>
        </div>
      </dl>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .project-header {
    display: grid;
    gap: var(--space-6);
    padding-bottom: var(--section-space);
  }

  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  dt {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    text-transform: uppercase;
  }

  dd {
    margin: var(--space-2) 0 0;
  }

  @media (max-width: 36rem) {
    dl {
      grid-template-columns: 1fr;
    }
  }
</style>
