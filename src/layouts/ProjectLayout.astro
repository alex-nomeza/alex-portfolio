---
import { Image } from 'astro:assets';
import { LinkButton } from '../components/ui/link-button';
import { withBase } from '../utils/paths';
import BaseLayout from './BaseLayout.astro';
import ProjectGallery from '../components/project/ProjectGallery.astro';
import NextProject from '../components/project/NextProject.astro';
import ZahirSlideshow from '../components/project/ZahirSlideshow.astro';
import type { Project } from '../utils/projects';
import SiteDemos from '../components/project/SiteDemos.astro';

interface Props {
  project: Project;
  next?: Project;
}

const { project, next } = Astro.props;
const { data } = project;

const title = (data.seo?.title ?? data.title).replace(/ — Alex Rafanomezantsoa$/, '');
const description = data.seo?.description ?? data.summary;

interface MetaItem {
  label: string;
  value: string;
}

const meta: MetaItem[] = [
  { label: 'Disciplines', value: data.disciplines.join(', ') },
  { label: 'Rôle', value: data.role.join(', ') },
];
if (data.client) meta.push({ label: 'Client', value: data.client });
if (data.technologies?.length) {
  meta.push({ label: 'Technologies', value: data.technologies.join(', ') });
}

const links = [
  data.externalUrl ? { label: 'Voir le projet', href: data.externalUrl } : null,
  data.repositoryUrl ? { label: 'Code source', href: data.repositoryUrl } : null,
].filter((link): link is { label: string; href: string } => link !== null);
---

<BaseLayout title={`${title} — Alex Rafanomezantsoa`} description={description}>
  <article class="project container">
    <LinkButton direction="left" href={withBase('work/')}>Tous les projets</LinkButton>
    <div
      class:list={[
        'project-opening editorial-grid',
        { 'project-opening-showcase': project.id === 'le-zahir' },
      ]}
    >
      <header class="project-header">
        <p class="eyebrow">Projet · {data.year}</p>
        <h1 class="project-title">{data.title}</h1>
        {data.subtitle && <p class="project-subtitle">{data.subtitle}</p>}

        <dl class="project-meta">
          {
            meta.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))
          }
        </dl>

        {
          links.length > 0 && (
            <p class="project-links">
              {links.map((link) => (
                <LinkButton
                  direction="external"
                  href={link.href}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  {link.label}
                </LinkButton>
              ))}
            </p>
          )
        }
      </header>

      {
        project.id !== 'le-zahir' && (
          <Image
            class="project-cover"
            src={data.cover}
            alt={data.coverAlt}
            widths={[768, 1200, 1600, 2000]}
            sizes="(min-width: 56rem) 50vw, 100vw"
            loading="eager"
          />
        )
      }
    </div>
    {project.id === 'le-zahir' && <ZahirSlideshow src={data.cover} alt={data.coverAlt} />}
    <div class="project-body editorial-reading">
      <slot />
      {project.id === 'web-digital-selection' && <SiteDemos />}
    </div>

    {data.gallery && <ProjectGallery items={data.gallery} />}

    {next && <NextProject project={next} />}
    <footer class="project-footer page-actions">
      <LinkButton href={withBase('work/')} direction="left">Tous les projets</LinkButton>
      <LinkButton href={withBase('contact/')}>Discuter d’un projet</LinkButton>
    </footer>
  </article>
</BaseLayout>

<style>
  .project {
    padding-block: var(--space-5) var(--section-space);
  }
  .project-opening {
    margin-top: var(--space-6);
    align-items: start;
  }
  .project-header {
    display: grid;
    gap: var(--space-5);
  }
  .project-opening-showcase {
    display: block;
  }
  @media (min-width: 56rem) {
    .project-opening-showcase .project-header {
      grid-template-columns: var(--editorial-left) var(--editorial-right);
      column-gap: var(--editorial-gap);
    }
    .project-opening-showcase .project-header > :not(.project-meta) {
      grid-column: 1;
    }
    .project-opening-showcase .project-meta {
      grid-column: 2;
      grid-row: 1 / 4;
      margin: 0;
      padding: 0;
      border: 0;
    }
  }
  .project-title {
    font-size: var(--font-size-hero);
    line-height: var(--line-snug);
    max-width: 16ch;
  }
  .project-subtitle {
    max-width: 38ch;
    color: var(--color-text-muted);
    margin: 0;
    font-size: var(--font-size-body-lg);
  }
  .project-meta {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-5) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .project-meta dt {
    font-size: var(--font-size-meta);
    color: var(--color-text-muted);
  }
  .project-meta dd {
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-nav);
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .project-cover {
    display: block;
    width: 100%;
    height: auto;
  }
  .project-body {
    margin-top: var(--section-space);
  }
  .project-footer {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    justify-content: space-between;
  }
  @media (min-width: 56rem) {
    .project-body {
      margin-left: auto;
      max-width: none;
      width: calc((100% - var(--editorial-gap)) * 0.55);
    }
  }
</style>
