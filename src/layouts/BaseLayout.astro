---
import Footer from '../components/global/Footer.astro';
import Header from '../components/global/Header.astro';
import '../styles/global.css';
import interFont from '../assets/fonts/inter-latin.woff2?url';
import titleFont from '../assets/fonts/bricolage-grotesque-latin.woff2?url';
import logoFont from '../assets/fonts/google-sans-latin.woff2?url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={titleFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={logoFont} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Aller au contenu</a>
    <Header pathname={Astro.url.pathname} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
